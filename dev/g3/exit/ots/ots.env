# OpenTAKServer's settings for the exit run (compose.yml). The database
# is reachable only on the compose project's own network, never from the
# Mac, so its password is a fixed local one.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://ots:ots-exit@ots-db/ots
OTS_FQDN=_
OTS_RABBITMQ_SERVER_ADDRESS=rabbitmq
OTS_LISTENER_ADDRESS=0.0.0.0
POSTGRES_PASSWORD=ots-exit
POSTGRES_USER=ots
POSTGRES_DB=ots
PGUSER=ots
