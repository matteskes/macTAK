+#include "ngtcp2/ngtcp2_crypto_ossl.h"
 #include "openssl/ssl.h"
 #include "openssl/rand.h"
 
@@ -11,7 +11,28 @@
 using namespace atakmap::commoncommo;
 using namespace atakmap::commoncommo::impl;
 
+// macTAK: ngtcp2's ossl backend (OpenSSL 3.5's own QUIC TLS API) in place
+// of quictls (a fork of OpenSSL 3.0, end of life 2026-09-07), so QUIC runs
+// on the same OpenSSL as the rest of commo. quictls'
+// configure_*_context pinned the SSL_CTX to TLS 1.3 and installed the
+// QUIC method; here the pin stays on the context and the callbacks go on
+// each session (attachOsslBackend).
+namespace {
+    bool configureTls13Only(SSL_CTX *sslCtx)
+    {
+        return SSL_CTX_set_min_proto_version(sslCtx, TLS1_3_VERSION) == 1 &&
+               SSL_CTX_set_max_proto_version(sslCtx, TLS1_3_VERSION) == 1;
+    }
 
+    // ngtcp2 recommends initialising the backend once, before first use
+    void initOsslBackendOnce()
+    {
+        static const int initResult = ngtcp2_crypto_ossl_init();
+        (void)initResult;
+    }
+}
+
+
 namespace {
     void rand_cb_impl(uint8_t *dest, size_t destlen, const ngtcp2_rand_ctx *randctx) {
         RAND_bytes(dest, (int)destlen);
@@ -42,6 +63,7 @@
         logger(logger),
         sslCtx(NULL),
         ssl(NULL),
+        ngOsslCtx(NULL),
         ngConnRef{getConnFromRefCb, this},
         ngConn(NULL),
         state(Prehandshake),
@@ -120,11 +142,12 @@
             throw std::invalid_argument("Could not create ngtcp2 server");
 
         // Set up TLS/SSL layer
+        initOsslBackendOnce();
         sslCtx = SSL_CTX_new(TLS_server_method());
         if (!sslCtx)
             throw std::invalid_argument("Could create TLS layer");
         
-        if (ngtcp2_crypto_quictls_configure_server_context(sslCtx) != 0)
+        if (!configureTls13Only(sslCtx))
             throw std::invalid_argument("ngtcp2 config of TLS layer failed");
         
         SSL_CTX_set_alpn_select_cb(sslCtx, selectAlpnSSLCb, this);
@@ -141,7 +164,10 @@
         
         SSL_set_app_data(ssl, &ngConnRef);
         SSL_set_accept_state(ssl);
-        ngtcp2_conn_set_tls_native_handle(ngConn, ssl);
+        if (ngtcp2_crypto_ossl_configure_server_session(ssl) != 0 ||
+            ngtcp2_crypto_ossl_ctx_new(&ngOsslCtx, ssl) != 0)
+            throw std::invalid_argument("ngtcp2 config of TLS session failed");
+        ngtcp2_conn_set_tls_native_handle(ngConn, ngOsslCtx);
 
         txBufferSize = 2 * STREAM_FLOW_CTRL_BYTES;
         txBuffer = new uint8_t[txBufferSize];
@@ -172,6 +198,7 @@
