diff --git a/core/impl/netsocket.cpp b/core/impl/netsocket.cpp
--- a/core/impl/netsocket.cpp
+++ b/core/impl/netsocket.cpp
@@ -5,9 +5,29 @@
 #include <string.h>
 #include <sys/types.h>
 #include <stdint.h>
+#include <cerrno>
+#include <string>
 
 using namespace atakmap::commoncommo;
 using namespace atakmap::commoncommo::impl;
+
+namespace {
+    // macTAK: a failed datagram call's cause, read right after the call, for
+    // SocketException's message. The bare SocketException() these calls threw
+    // said "An unknown error occurred", and the QUIC handshake reported only
+    // "quic IO error during handshake" (dev/spike/g55/NOTES.md trap 8).
+    std::string socketErrorWhat(const char *call)
+    {
+#ifdef WIN32
+        return std::string(call) + " failed (WSA error "
+               + std::to_string(WSAGetLastError()) + ")";
+#else
+        const int err = errno;
+        return std::string(call) + " failed: " + strerror(err)
+               + " (errno " + std::to_string(err) + ")";
+#endif
+    }
+}
 
 // Define to try supporting ipv6
 //#define COMMO_USE_IPV6 1
@@ -545,7 +565,8 @@
     case PlatformNet::IO_WOULD_BLOCK:
         throw SocketWouldBlockException();
     default:
-        throw SocketException();
+        throw SocketException(netinterfaceenums::ERR_OTHER,
+                              socketErrorWhat("recvfrom"));
     }
 
     try {
@@ -593,7 +614,8 @@
     case PlatformNet::IO_WOULD_BLOCK:
         throw SocketWouldBlockException();
     default:
-        throw SocketException();
+        throw SocketException(netinterfaceenums::ERR_OTHER,
+                              socketErrorWhat("sendto"));
     }
 }
 
